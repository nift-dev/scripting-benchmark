{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark environment",
  "type": "object",
  "required": [
    "schema_version",
    "captured_at",
    "os",
    "machine",
    "runtimes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "captured_at": {
      "type": "string"
    },
    "os": {
      "type": "object"
    },
    "machine": {
      "type": "object"
    },
    "runtimes": {
      "type": "array"
    }
  }
}
